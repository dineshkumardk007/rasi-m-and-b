# ─── Rasi Mom & Baby — environment variables ───────────────────────────────
# Copy to .env.local and fill in. The app REFUSES to start with missing keys.
# Never commit .env.local.

# Supabase (required from Phase 0) — dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin login (/admin) — REQUIRED, there is no built-in fallback.
# Generate with:  pnpm admin:password "your-password"   and   pnpm admin:password --secret
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Razorpay (required from Phase 2) — dashboard → Settings → API Keys
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# n8n automation (required from Phase 4)
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=

# Cron auth — REQUIRED on Vercel or /api/cron/drain-events refuses every
# request (fails closed). Set the same value in the Vercel project env;
# Vercel then sends it back as `Authorization: Bearer $CRON_SECRET` itself.
# CRON_SECRET=

# Analytics — with neither set, no tag loads and no request leaves the page.
# Meta: Events Manager → Data sources → your pixel (a ~15-digit number)
# GA4:  Admin → Data streams → your web stream ("G-XXXXXXXXXX")
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Error tracking (Sentry) — sentry.io → Settings → Projects → Client Keys (DSN).
# Not a secret (ships in the client bundle); with it unset, error tracking is
# simply off.
# NEXT_PUBLIC_SENTRY_DSN=

# Sourcemap upload at build time (optional — without it, Sentry still
# captures errors, just with minified stack traces). sentry.io → Settings →
# Auth Tokens (needs project:releases scope).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
